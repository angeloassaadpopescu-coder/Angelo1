{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "baseUrl": "./",
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@/*": ["src/*"],
      "@agents/*": ["../../packages/agents/src/*"],
      "@types/*": ["../../packages/types/src/*"],
      "@shared/*": ["../../packages/shared/src/*"],
      "@utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
